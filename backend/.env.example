KTK_APP_NAME=KTK ELOU-AVT Backend
KTK_APP_VERSION=0.4.0
KTK_ENVIRONMENT=development
KTK_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KTK_SIMULATION_AUTO_RUN=true
KTK_SIMULATION_TICK_INTERVAL_MS=1000
# Локальный вариант по умолчанию: не требует отдельного сервера БД.
KTK_DATABASE_URL=sqlite+pysqlite:///./ktk_simulator.sqlite3
# Целевой вариант с отдельно запущенным PostgreSQL:
# KTK_DATABASE_URL=postgresql+psycopg://ktk:ktk@localhost:5432/ktk_simulator
