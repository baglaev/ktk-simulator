# OpenAI-compatible provider. Do not commit a real API key.
AI_LLM_ENABLED=true
AI_LLM_BASE_URL=https://openrouter.ai/api/v1
AI_LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Request limits for one post-session report.
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_MAX_TOKENS=1200
AI_LLM_TEMPERATURE=0.2
AI_LLM_DATA_COLLECTION=deny

# Optional OpenRouter attribution headers.
AI_LLM_SITE_URL=
AI_LLM_APP_NAME="KTK ELOU-AVT AI"
